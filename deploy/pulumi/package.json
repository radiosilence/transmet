{
  "name": "@radiosilence/transmet-pulumi",
  "version": "0.2.0",
  "description": "Pulumi component that deploys the transmet comic reader into Kubernetes",
  "license": "UNLICENSED",
  "private": false,
  "author": "James Cleveland <jc@blit.cc>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radiosilence/transmet.git",
    "directory": "deploy/pulumi"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@pulumi/kubernetes": "^4",
    "@pulumi/pulumi": "^3"
  },
  "devDependencies": {
    "@pulumi/kubernetes": "4.30.0",
    "@pulumi/pulumi": "3.239.0",
    "typescript": "6.0.3"
  }
}
